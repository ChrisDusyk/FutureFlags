{
  "version": 2,
  "note": "The whole ruleset, answered for one context. The 'ruleset' member is byte-for-byte what GET /api/evaluation/ruleset returns and 'context' is what POST /api/evaluation accepts as its context, so each suite must read them with its production parser. If a case here needs a shape the wire does not have, the design is wrong rather than the file.",
  "expectedNote": "Version 2 asserts the whole resolution, not just the boolean. 'reason' and 'variant' are OpenFeature's, and 'errorCode' is asserted explicitly — including its absence. That last part is the point of the version bump: a normal resolution must never carry an error code, and a reason-only assertion would not catch a regression that started setting one alongside DEFAULT. Reasons map as: off here is DISABLED; on and targeting nobody is STATIC; on and matched is TARGETING_MATCH; on, targeting, and matched nothing is DEFAULT with no error. A flag the ruleset does not carry is ERROR/FLAG_NOT_FOUND, which is what the optional 'missing' member asserts, since a whole-ruleset answer can never contain a key it has never heard of.",
  "cases": [
    {
      "name": "off beats everything, including a segment that matches",
      "ruleset": {
        "environment": "prod",
        "flags": [{ "key": "new-checkout", "isEnabled": false, "targetedSegments": ["everyone"] }],
        "segments": [
          {
            "key": "everyone",
            "included": [],
            "excluded": [],
            "conditions": [{ "attribute": "any", "operator": "equals", "values": [true] }]
          }
        ]
      },
      "context": { "key": "user-17", "attributes": { "any": true } },
      "expected": { "new-checkout": { "value": false, "variant": "off", "reason": "DISABLED" } }
    },
    {
      "name": "on with no targets is on for everyone, including an empty context",
      "ruleset": {
        "environment": "prod",
        "flags": [{ "key": "dark-mode", "isEnabled": true, "targetedSegments": [] }],
        "segments": []
      },
      "context": { "attributes": {} },
      "expected": { "dark-mode": { "value": true, "variant": "on", "reason": "STATIC" } }
    },
    {
      "name": "on with targets is off for a context that matches none of them, and that is DEFAULT rather than an error",
      "ruleset": {
        "environment": "prod",
        "flags": [{ "key": "new-checkout", "isEnabled": true, "targetedSegments": ["beta-testers"] }],
        "segments": [
          {
            "key": "beta-testers",
            "included": ["user-17"],
            "excluded": [],
            "conditions": []
          }
        ]
      },
      "context": { "key": "user-99", "attributes": {} },
      "expected": { "new-checkout": { "value": false, "variant": "off", "reason": "DEFAULT" } }
    },
    {
      "name": "an empty context reads a targeted flag as off, which is what keeps the no-context SDK call safe",
      "ruleset": {
        "environment": "prod",
        "flags": [
          { "key": "new-checkout", "isEnabled": true, "targetedSegments": ["beta-testers"] },
          { "key": "dark-mode", "isEnabled": true, "targetedSegments": [] }
        ],
        "segments": [
          { "key": "beta-testers", "included": ["user-17"], "excluded": [], "conditions": [] }
        ]
      },
      "context": { "attributes": {} },
      "expected": {
        "new-checkout": { "value": false, "variant": "off", "reason": "DEFAULT" },
        "dark-mode": { "value": true, "variant": "on", "reason": "STATIC" }
      }
    },
    {
      "name": "targets are an OR, so one match is enough",
      "ruleset": {
        "environment": "prod",
        "flags": [{ "key": "f", "isEnabled": true, "targetedSegments": ["by-plan", "by-key"] }],
        "segments": [
          {
            "key": "by-plan",
            "included": [],
            "excluded": [],
            "conditions": [{ "attribute": "plan", "operator": "equals", "values": ["enterprise"] }]
          },
          { "key": "by-key", "included": ["user-17"], "excluded": [], "conditions": [] }
        ]
      },
      "context": { "key": "user-17", "attributes": { "plan": "free" } },
      "expected": { "f": { "value": true, "variant": "on", "reason": "TARGETING_MATCH" } }
    },
    {
      "name": "a targeted segment this ruleset does not carry is a non-match, not a failure",
      "ruleset": {
        "environment": "prod",
        "flags": [{ "key": "f", "isEnabled": true, "targetedSegments": ["deleted-yesterday"] }],
        "segments": []
      },
      "context": { "key": "user-17", "attributes": { "plan": "pro" } },
      "expected": { "f": { "value": false, "variant": "off", "reason": "DEFAULT" } }
    },
    {
      "name": "a missing segment does not stop the other target from matching",
      "ruleset": {
        "environment": "prod",
        "flags": [{ "key": "f", "isEnabled": true, "targetedSegments": ["deleted-yesterday", "by-key"] }],
        "segments": [{ "key": "by-key", "included": ["user-17"], "excluded": [], "conditions": [] }]
      },
      "context": { "key": "user-17", "attributes": {} },
      "expected": { "f": { "value": true, "variant": "on", "reason": "TARGETING_MATCH" } }
    },
    {
      "name": "one segment reused by two flags answers the same way for both",
      "ruleset": {
        "environment": "stg",
        "flags": [
          { "key": "a", "isEnabled": true, "targetedSegments": ["staff"] },
          { "key": "b", "isEnabled": true, "targetedSegments": ["staff"] },
          { "key": "c", "isEnabled": false, "targetedSegments": ["staff"] }
        ],
        "segments": [
          {
            "key": "staff",
            "included": [],
            "excluded": [],
            "conditions": [{ "attribute": "email", "operator": "ends-with", "values": ["@acme.example"] }]
          }
        ]
      },
      "context": { "key": "user-17", "attributes": { "email": "dana@acme.example" } },
      "expected": {
        "a": { "value": true, "variant": "on", "reason": "TARGETING_MATCH" },
        "b": { "value": true, "variant": "on", "reason": "TARGETING_MATCH" },
        "c": { "value": false, "variant": "off", "reason": "DISABLED" }
      }
    },
    {
      "name": "an excluded key is off even where the flag targets a segment they would otherwise be in",
      "ruleset": {
        "environment": "prod",
        "flags": [{ "key": "f", "isEnabled": true, "targetedSegments": ["pro-users"] }],
        "segments": [
          {
            "key": "pro-users",
            "included": [],
            "excluded": ["user-17"],
            "conditions": [{ "attribute": "plan", "operator": "equals", "values": ["pro"] }]
          }
        ]
      },
      "context": { "key": "user-17", "attributes": { "plan": "pro" } },
      "expected": { "f": { "value": false, "variant": "off", "reason": "DEFAULT" } }
    },
    {
      "name": "an empty ruleset answers nothing rather than failing",
      "ruleset": { "environment": "dev", "flags": [], "segments": [] },
      "context": { "key": "user-17", "attributes": {} },
      "expected": {}
    },
    {
      "name": "a key the ruleset does not carry resolves ERROR/FLAG_NOT_FOUND rather than a silent off",
      "ruleset": {
        "environment": "prod",
        "flags": [{ "key": "dark-mode", "isEnabled": true, "targetedSegments": [] }],
        "segments": []
      },
      "context": { "key": "user-17", "attributes": {} },
      "expected": { "dark-mode": { "value": true, "variant": "on", "reason": "STATIC" } },
      "missing": ["never-defined", "dark-mode-typo"]
    },
    {
      "name": "an explicit boolean variant set on the wire is read rather than assumed",
      "ruleset": {
        "environment": "prod",
        "flags": [
          {
            "key": "explicit",
            "isEnabled": true,
            "targetedSegments": [],
            "valueType": "boolean",
            "variants": { "on": true, "off": false },
            "onVariant": "on",
            "offVariant": "off"
          }
        ],
        "segments": []
      },
      "context": { "key": "user-17", "attributes": {} },
      "expected": { "explicit": { "value": true, "variant": "on", "reason": "STATIC" } }
    },
    {
      "name": "variant names are the flag's own, and a disabled flag serves the one it names for off",
      "ruleset": {
        "environment": "prod",
        "flags": [
          {
            "key": "renamed",
            "isEnabled": false,
            "targetedSegments": [],
            "valueType": "boolean",
            "variants": { "enabled": true, "disabled": false },
            "onVariant": "enabled",
            "offVariant": "disabled"
          }
        ],
        "segments": []
      },
      "context": { "key": "user-17", "attributes": {} },
      "expected": { "renamed": { "value": false, "variant": "disabled", "reason": "DISABLED" } }
    }
  ]
}
