<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FeatureFlags.Client\FeatureFlags.Client.csproj" />
  </ItemGroup>

  <!--
    The same conformance vectors FeatureFlags.Domain.Tests runs. Here they check that the
    netstandard2.0, net8.0, and net10.0 compilations of the shared evaluator agree with each other
    and with the server's — the Node suite is what polices an independent implementation.
  -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../../../shared/evaluation/conformance/*.json"
             LinkBase="conformance"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
