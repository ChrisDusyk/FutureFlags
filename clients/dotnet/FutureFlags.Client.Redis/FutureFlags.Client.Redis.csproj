<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Same floor as FutureFlags.Client, and for the same reason: FusionCache and the Redis packages
    below all support netstandard2.0, so there is no technical reason to strand a Framework/Mono/
    Unity consumer of the base package from this add-on.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>FutureFlags.Client.Redis</PackageId>
    <Description>Optional Redis cache tier for FutureFlags.Client. Backs the in-memory snapshot with Redis the host application already runs, so a cold-started instance answers from a warm value instead of a default, and an outage is survived for as long as the Redis entry's fail-safe window rather than only as long as one process stays up.</Description>
    <PackageTags>feature-flags;feature-toggles;futureflags;redis;fusioncache</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ChrisDusyk/FutureFlags</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Directory.Build.props applies MinVer with the platform's `v` tag prefix, so a local pack here
    carries the *platform's* version rather than the SDK's. That is only ever a local build:
    sdk-release.yml packs with -p:MinVerVersionOverride taken from the sdk-dotnet-v* tag, same as
    FutureFlags.Client — this package ships on the same tag, since it references the base package
    by project reference and has no reason to version separately from it.
  -->

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FutureFlags.Client.Redis.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FutureFlags.Client\FutureFlags.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="ZiggyCreatures.FusionCache" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" />
  </ItemGroup>

  <!--
    No direct System.Text.Json reference, on any target: the base package pins it to 8.0.5 on
    netstandard2.0 (the BCL-replacement floor explained in Directory.Packages.props), but
    ZiggyCreatures.FusionCache.Serialization.SystemTextJson needs >= 10.0.1 there — a direct
    reference at 8.0.5 would be a downgrade NuGet refuses to resolve. [JsonConstructor] below
    compiles fine against whatever version flows in transitively from that package.
  -->

</Project>
