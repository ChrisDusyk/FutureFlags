{
  "name": "@futureflags/client",
  "version": "0.0.0",
  "description": "Client for a self-hosted FutureFlags installation. Runs on a server or in a browser, reading flag states for the environment its SDK key is scoped to.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "packageManager": "pnpm@10.33.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisDusyk/FutureFlags.git",
    "directory": "clients/node"
  },
  "homepage": "https://github.com/ChrisDusyk/FutureFlags/tree/main/clients/node",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "futureflags"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openfeature/server": {
      "types": "./dist/openfeature/server.d.ts",
      "default": "./dist/openfeature/server.js"
    },
    "./openfeature/web": {
      "types": "./dist/openfeature/web.d.ts",
      "default": "./dist/openfeature/web.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openfeature/server-sdk": "^1.23.0",
    "@openfeature/web-sdk": "^1.10.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.23.0",
    "@openfeature/web-sdk": "^1.10.0"
  },
  "peerDependenciesMeta": {
    "@openfeature/server-sdk": {
      "optional": true
    },
    "@openfeature/web-sdk": {
      "optional": true
    }
  }
}
