<Project>

  <!--
    One version per package, for the whole repository.

    Before this file, xunit, the test SDK, coverlet, and TimeProvider.Testing each carried their
    version in three separate csproj files, which is three places to miss when one of them moves.
    The csproj files now say only which packages they need; this file says which versions.

    Two clocks run here, and the split is deliberate rather than neglect — see the client section.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      A project that asks for a package with no PackageVersion entry should fail loudly rather
      than silently resolving whatever a transitive reference dragged in.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Aspire. These have to stay in step with the Aspire.AppHost.Sdk version pinned in
    FutureFlags.AppHost.csproj — an SDK reference, which central package management does not
    reach, so moving one means moving the other by hand.
  -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.5.3" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.5.3" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.5.3" />
    <PackageVersion Include="Aspire.StackExchange.Redis.OutputCaching" Version="13.5.3" />
  </ItemGroup>

  <!-- Server and infrastructure. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />

    <!--
      Direct only to lift the transitive Microsoft.OpenApi off 2.0.0, which has a high-severity
      advisory (GHSA-v5pm-xwqc-g5wc). The reasoning lives on the PackageReference in
      FutureFlags.Server.csproj, which is where somebody will look when deciding to drop it.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.0" />
  </ItemGroup>

  <!-- Telemetry. -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <!--
    The .NET client library, and the reason this file cannot be one flat list sorted to the
    newest version of everything.

    FutureFlags.Client targets netstandard2.0 so that .NET Framework, Mono, and Unity consumers
    can use it. These 8.0.x floors are what a consumer's own application gets pulled up to, so
    raising them is a breaking change for somebody on an older runtime — the whole point of the
    netstandard2.0 target. They move on the SDK's clock (sdk-dotnet-v* tags), not the platform's.
    Do not "tidy" them up to match the 10.x versions above.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageVersion Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!--
    The optional Redis cache add-on (FutureFlags.Client.Redis). Also netstandard2.0, for the same
    consumers as the base client above — but these are not in-box-replacement BCL packages with a
    reason to stay pinned to an old floor the way the group above is. FusionCache and the Redis
    packages are third-party libraries with their own release cadence, so they move on that cadence
    rather than being held down to what a Framework/Unity runtime already ships.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.6.0" />
  </ItemGroup>

  <!--
    Testing. The client's tests target net10.0 and are not bound by the netstandard2.0 floor above
    — they exercise the package, they are not shipped with it.
  -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="StackExchange.Redis" Version="3.1.13" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.14.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <!-- Versioning, applied to every project by Directory.Build.props. -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="7.0.0" />
  </ItemGroup>

</Project>
