# cp .env.example .env, fill in the three values below, then `docker compose up -d`.

# The origin a browser will load the console on, scheme included.
#
# This is the one setting worth getting right first. It decides the certificate Caddy requests
# and the origin the auth service trusts, and those have to agree — a mismatch does not fail at
# startup, it fails at somebody's first sign-in with an error that does not name the cause.
#
# A scheme, a host, and a port if it is not the default — nothing after it. The server refuses
# anything else on startup, because a path or a bare hostname is not what a browser sends and
# could never match. That check cannot tell whether the hostname itself is the right one.
#
# Use https:// with a public DNS name pointed at this host. For a local trial without DNS, use
# http://localhost — Caddy will serve it plain rather than trying to obtain a certificate.
FUTUREFLAGS_ORIGIN=https://flags.example.com

# Signs sessions and the ES256 tokens the API validates. Generate one and keep it:
#
#   openssl rand -base64 32
#
# Changing it later invalidates every existing session, which signs everyone out.
BETTER_AUTH_SECRET=

# Only used by the bundled postgres service. Ignored if you set FUTUREFLAGS_DATABASE_URL below.
#
# Generate a URL-safe one — hex, not base64:
#
#   openssl rand -hex 24
#
# This value is interpolated into a postgres:// URL, and base64 output contains '/' and '+'. A '/'
# ends the authority portion of a URL, so the password would be silently truncated there and the
# connection would fail to authenticate with nothing pointing at the password as the cause. If you
# must use a password containing /, @, :, or #, percent-encode it and set FUTUREFLAGS_DATABASE_URL
# below by hand.
POSTGRES_PASSWORD=

# --- optional ---------------------------------------------------------------------------

# Pin a release instead of tracking latest. Recommended once you are past trying it out:
# `latest` moving under an unattended `docker compose pull` is how an upgrade happens by
# accident. See the release notes before changing it.
#FUTUREFLAGS_VERSION=1.0.0

# Use a database you already run, rather than the bundled one. Comment out the `postgres`
# service in docker-compose.yml as well, or it will keep running unused.
#FUTUREFLAGS_DATABASE_URL=postgres://user:password@db.example.com:5432/futureflagsdb

# Likewise for Redis.
#FUTUREFLAGS_REDIS_URL=redis://cache.example.com:6379
