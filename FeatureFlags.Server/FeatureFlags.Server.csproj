<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The OpenAPI document is what the NuGet and npm client libraries are generated from, so it has
    to exist as a file rather than only at /openapi/v1.json in Development.

    Generating it means running the application far enough to build its service provider, which
    needs the auth service's address — so it is off by default rather than slowing (and breaking)
    every ordinary build. The release workflow opts in:

      FEATUREFLAGS_AUTH_URL=http://localhost dotnet build -p:OpenApiGenerateDocumentsOnBuild=true
  -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOnBuild Condition="'$(OpenApiGenerateDocumentsOnBuild)' == ''">false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
    <PackageReference Include="Aspire.StackExchange.Redis.OutputCaching" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <!--
      Direct only to lift the transitive Microsoft.OpenApi off 2.0.0, which has a high-severity
      advisory (GHSA-v5pm-xwqc-g5wc: a circular schema reference can terminate parsing), patched
      in 2.7.5. Microsoft.AspNetCore.OpenApi asks for ">= 2.0.0" and NuGet resolves the lowest
      match, so bumping the parent does not help — every 10.0.x still lands on 2.0.0. Nothing in
      this project uses the package directly; drop this line once the parent's floor clears 2.7.5.
    -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FeatureFlags.Domain\FeatureFlags.Domain.csproj" />
    <ProjectReference Include="..\FeatureFlags.Infrastructure\FeatureFlags.Infrastructure.csproj" />
  </ItemGroup>

  <!-- EvaluateForContextEndpoint.Bind is the untrusted-input validation for the one route a
       publishable key can reach, and is worth testing directly rather than only through a live
       HTTP call — see EvaluateForContextEndpointTests. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FeatureFlags.Server.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
