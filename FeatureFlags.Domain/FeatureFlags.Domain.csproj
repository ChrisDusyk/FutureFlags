<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    FeatureFlagRepository clears a flag's UncommittedEvents once it has durably appended them —
    that has to be a real mutation on the aggregate, not something a repository fakes from outside,
    so Infrastructure gets access to this one internal member rather than the method going public
    for everyone.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FeatureFlags.Infrastructure</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The evaluation engine is shared source, not a project reference, because clients/dotnet's
    FeatureFlags.Client targets netstandard2.0 and can never reference this project. Linking the
    same files into both is what makes "the server and the SDK agree" a compiler guarantee rather
    than a promise. See shared/evaluation/README.md for what that costs.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../shared/evaluation/dotnet/**/*.cs" LinkBase="Evaluation" />
  </ItemGroup>

</Project>
